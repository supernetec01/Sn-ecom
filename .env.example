# Copy to a local ignored .env and supply real values securely. Never commit keys.
# Start with: node --env-file=.env server.js
PORT=3000
# Bind to 127.0.0.1 and TRUST_PROXY=loopback only with a proxy on this machine.
# npm run demo sets these automatically; ordinary hosting uses its own proxy rules.
HOST=0.0.0.0
TRUST_PROXY=
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development

# Resend. Requires a verified sender/domain. The outbox worker sends email.
EMAIL_API_KEY=
EMAIL_FROM=

# Optional OpenAI model for the product assistant. No key => catalog search fallback.
AI_API_KEY=
AI_MODEL=
CHAT_DAILY_LIMIT=200

# VNPay merchant configuration. Sandbox is the default. No credentials => method hidden.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_LIVE=false

# Optional public product/editorial translation. UI labels work without a key.
# Enable Cloud Translation API (Basic v2) and restrict the key to that API.
TRANSLATION_API_KEY=
TRANSLATION_DAILY_CHAR_LIMIT=100000
