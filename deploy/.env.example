# Copy to deploy/.env on the Linux server. Use one hostname, no https:// or slash.
SITE_DOMAIN=shop.example.vn
# Optional Resend configuration; store the real key ONLY on the server.
EMAIL_API_KEY=
EMAIL_FROM=
# Optional integrations; leave empty unless already configured and verified.
AI_API_KEY=
AI_MODEL=
TRANSLATION_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_LIVE=false
